# Copy to .env.n8n and pass it with `docker compose --env-file .env.n8n up -d`.
# Keep these values private and use separate secrets for each environment.
N8N_PUBLIC_WEBHOOK_URL=https://replace-with-a-public-https-tunnel
N8N_ENCRYPTION_KEY=generate-a-private-random-value-at-least-32-characters
LENDLOOP_HMAC_SECRET=use-the-same-private-secret-configured-in-convex
LENDLOOP_CONVEX_HTTP_URL=https://your-deployment.convex.site
GENERIC_TIMEZONE=UTC
