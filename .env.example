# Copy these values into .env.local for the Next.js app. Do not commit credentials.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=

# Configure these on the Convex deployment with `npx convex env set`.
CLERK_JWT_ISSUER_DOMAIN=
N8N_REQUEST_WEBHOOK_URL=
LENDLOOP_HMAC_SECRET=
